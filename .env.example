# ─── Home Assistant ───────────────────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token_here

# ─── Online LLM APIs (optional – used only when local models escalate) ────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── n8n ──────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_ENCRYPTION_KEY=changeme32charsminimumrequired00

# ─── Email (IMAP) ─────────────────────────────────────────────────────────────
# Leave empty to disable email integration
EMAIL_HOST=
EMAIL_PORT=993
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ─── Paperless-ngx ────────────────────────────────────────────────────────────
PAPERLESS_SECRET_KEY=changeme-paperless-secret
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme
# Get this token from Paperless admin → your profile → API tokens
PAPERLESS_TOKEN=

# ─── Firefly III ──────────────────────────────────────────────────────────────
FIREFLY_APP_KEY=SomeRandomStringOf32CharsExactly
FIREFLY_DB_ROOT_PASSWORD=firefly_root
FIREFLY_DB_PASSWORD=firefly_pass
# Get this token from Firefly III → profile → OAuth → Personal Access Tokens
FIREFLY_TOKEN=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
